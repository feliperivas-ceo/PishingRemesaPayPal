generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum RequestStatus {
  pendiente
  en_revision
  aprobada
  rechazada
  completada
}

enum PaymentReason {
  alimentacion
  compra_bienes
  gastos_personales
  apoyo_familiar
  educacion
  salud
  otro
}

enum SenderRelation {
  familiar
  pareja
  amigo
  empresa
  cliente
  otro
  no_sabe
}

enum ReceivingMethod {
  cuenta_bancaria
  billetera_digital
  efectivo
  otro
}

enum NotificationType {
  status_change
  request_created
  system
}

model User {
  id               String            @id @default(cuid())
  fullName         String
  email            String            @unique
  password         String
  role             UserRole          @default(user)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  transferRequests TransferRequest[] @relation("RequestOwner")
  statusChanges    StatusHistory[]   @relation("StatusChangedBy")
  internalNotes    InternalNote[]    @relation("NoteAuthor")
  notifications    Notification[]
}

model TransferRequest {
  id                  String          @id @default(cuid())
  requestNumber       String          @unique
  userId              String
  originCountry       String          @default("Canada")
  destinationCountry  String          @default("Colombia")
  amount              Decimal         @db.Decimal(12, 2)
  currency            String
  reason              PaymentReason
  senderRelation      SenderRelation
  beneficiaryFullName String
  beneficiaryEmail    String
  beneficiaryCountry  String
  beneficiaryCity     String
  beneficiaryPhone    String?
  receivingMethod     ReceivingMethod
  status              RequestStatus   @default(pendiente)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user                User            @relation("RequestOwner", fields: [userId], references: [id], onDelete: Cascade)
  internalNotes       InternalNote[]
  statusHistory       StatusHistory[]
  notifications       Notification[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([beneficiaryEmail])
}

model InternalNote {
  id        String          @id @default(cuid())
  requestId String
  authorId  String
  note      String
  createdAt DateTime        @default(now())

  request   TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User            @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

model StatusHistory {
  id             String          @id @default(cuid())
  requestId      String
  previousStatus RequestStatus?
  newStatus      RequestStatus
  changedById    String
  createdAt      DateTime        @default(now())

  request        TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  changedBy      User            @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  requestId String?
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  request    TransferRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([requestId])
}