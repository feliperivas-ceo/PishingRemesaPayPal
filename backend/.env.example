# Puerto del servidor
PORT=4000

# PostgreSQL local. Sustituye <password> por tu clave local (no la subas a Git).
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/remesas?schema=public"

# Secreto para firmar los JWT. Genera uno aleatorio y no lo subas a Git.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# development | production
NODE_ENV=development
